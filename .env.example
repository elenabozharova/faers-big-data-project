# ---------------------------------------------------------------------------
# decagon-preprocessing — environment variable template
#
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# To load automatically, add this to your script before importing anything:
#   from dotenv import load_dotenv; load_dotenv()
# Or set the variables directly in your shell / CI environment.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ChEMBL PostgreSQL
# Defaults match a local install with the chembl_36 dump.
# ---------------------------------------------------------------------------
CHEMBL_DB_NAME=chembl_36
CHEMBL_DB_USER=postgres
PGPASSWORD=your_password_here
CHEMBL_DB_HOST=localhost
CHEMBL_DB_PORT=5432

# ---------------------------------------------------------------------------
# STRING PPI
# Full path to the physical-links file for human proteins.
# Download from: https://string-db.org/cgi/download?species_text=Homo+sapiens
#   -> 9606.protein.physical.links.v12.0.txt.gz
# Default (if unset): data/raw/string/9606.protein.physical.links.v12.0.txt.gz
# ---------------------------------------------------------------------------
# STRING_PPI_PATH=/path/to/9606.protein.physical.links.v12.0.txt.gz

# ---------------------------------------------------------------------------
# UniProt ID mapping
# Downloaded automatically by process_string.py on first run (~80 MB).
# Override only if you want to store it outside data/raw/uniprot/.
# Default (if unset): data/raw/uniprot/HUMAN_9606_idmapping.dat.gz
# ---------------------------------------------------------------------------
# UNIPROT_IDMAPPING_PATH=/path/to/HUMAN_9606_idmapping.dat.gz

# ---------------------------------------------------------------------------
# FAERS
# The ZIP filename and inner file names change with each quarterly release.
# Download from: https://fis.fda.gov/extensions/FPD-QDE-FAERS/FPD-QDE-FAERS.html
# Update all three when you upgrade to a new quarter.
# Defaults (if unset) point to the 2025Q4 release.
# ---------------------------------------------------------------------------
# FAERS_ZIP_PATH=/path/to/faers_ascii_2025Q4.zip
# FAERS_DRUG_FILE=ASCII/DRUG25Q4.txt
# FAERS_REAC_FILE=ASCII/REAC25Q4.txt
